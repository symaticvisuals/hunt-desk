# Copy to .env and fill the keys you have. Blank values are skipped.
# The hunt CLI never prints these values.

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
FINDWORK_API_KEY=
REED_API_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Optional. Comma-separated proxies for JobSpy, host:port or user:pass@host:port
JOBSPY_PROXIES=

# Overleaf Git token from the project Menu, Git. Username is git. Never commit the real token.
OVERLEAF_GIT_TOKEN=

# Claude API key for sorting, scoring, tailoring, and the resume rewrite. The desk asks for it on first launch.
# Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Required when the key is not tied to one workspace. The id is on https://platform.claude.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=
